[
  {
    "name": "Call_Family",
    "sources": [
      "cdr-voice",
      "cdr-speech"
    ],
    "default": "CALL",
    "default_from": "",
    "expression": "",
    "rules": [
      {
        "when": "[Session_Type] CONTAINS MultiRAB",
        "value": "MultiRAB"
      },
      {
        "when": "[Session_Type] CONTAINS WhatsApp",
        "value": "WhatsApp"
      },
      {
        "when": "[Session_Type] = CALL",
        "value": "VoLTE"
      }
    ]
  },
  {
    "name": "Test_Family",
    "sources": [
      "cdr-data"
    ],
    "default": "",
    "default_from": "[Type_of_Test] OR [Test_Type]",
    "expression": "",
    "rules": [
      {
        "when": "[Test_Name] CONTAINS YouTube",
        "value": "YouTube"
      },
      {
        "when": "[Test_Name] CONTAINS FDFS",
        "value": "FDFS"
      },
      {
        "when": "[Test_Name] CONTAINS FDTT",
        "value": "FDTT"
      }
    ]
  },
  {
    "name": "Test_Result_Group",
    "sources": [
      "cdr-data",
      "cdr-voice",
      "cdr-speech"
    ],
    "default": "",
    "default_from": "",
    "expression": "",
    "rules": [
      {
        "when": "[Test_Result] OR [Call_Status] OR [status] IN (Completed, 'Visible Completed')",
        "value": "Success"
      },
      {
        "when": "[Test_Result] OR [Call_Status] OR [status] IN (Cutoff, Failed, Dropped)",
        "value": "Failure"
      }
    ]
  },
  {
    "name": "RAT_Group",
    "sources": [
      "cdr-data",
      "cdr-voice",
      "cdr-speech"
    ],
    "default": "",
    "default_from": "[RAT] OR [RAT_A]",
    "expression": "",
    "rules": [
      {
        "when": "[RAT] OR [RAT_A] IN ('NR SA', NE-DC, '5G NR', NR)",
        "value": "NR SA"
      },
      {
        "when": "[RAT] OR [RAT_A] IN (VoNR, VoNR/NR)",
        "value": "VoNR"
      },
      {
        "when": "[RAT] OR [RAT_A] CONTAINS VoNR",
        "value": "VoNR Mixed"
      },
      {
        "when": "[RAT] OR [RAT_A] CONTAINS EPSFB",
        "value": "EPSFB"
      },
      {
        "when": "[RAT] OR [RAT_A] CONTAINS ('NR SA', NE-DC) OR [RAT] OR [RAT_A] MATCHES '(^|/)NR(/|$)'",
        "value": "NR SA Mixed"
      },
      {
        "when": "[RAT] OR [RAT_A] IN (EN-DC, LTE-5GNR)",
        "value": "EN-DC"
      },
      {
        "when": "[RAT] OR [RAT_A] CONTAINS (EN-DC, LTE-5GNR)",
        "value": "ENDC Mixed"
      },
      {
        "when": "[RAT] OR [RAT_A] IN (VoLTE, LTE/VoLTE)",
        "value": "VoLTE"
      },
      {
        "when": "[RAT] OR [RAT_A] CONTAINS VoLTE",
        "value": "VoLTE Mixed"
      },
      {
        "when": "[RAT] OR [RAT_A] CONTAINS CSFB",
        "value": "CSFB"
      },
      {
        "when": "[RAT] OR [RAT_A] = LTE",
        "value": "LTE"
      },
      {
        "when": "[RAT] OR [RAT_A] CONTAINS LTE",
        "value": "LTE Mixed"
      },
      {
        "when": "[RAT] OR [RAT_A] CONTAINS (GSM, UMTS)",
        "value": "2G/3G"
      },
      {
        "when": "[RAT] OR [RAT_A] CONTAINS ('No Service', No_Service)",
        "value": "No Service"
      }
    ]
  },
  {
    "name": "NR_Mode_from_RAT",
    "sources": [
      "cdr-data",
      "cdr-voice",
      "cdr-speech"
    ],
    "default": "Others",
    "default_from": "",
    "expression": "",
    "rules": [
      {
        "when": "[RAT] OR [RAT_A] CONTAINS ('NR SA', NE-DC, VoNR, EPSFB, '5G NR') OR [RAT] OR [RAT_A] MATCHES '(^|/)NR(/|$)'",
        "value": "SA"
      },
      {
        "when": "[RAT] OR [RAT_A] CONTAINS (EN-DC, LTE-5GNR)",
        "value": "NSA"
      }
    ]
  }
]
