FROM python:3.15-slim

ARG TZ=Europe/Madrid

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DRIVETEST_ANALYZER_REPORT_CHART_RENDERER=canvas \
    TZ=${TZ}

WORKDIR /app

COPY requirements.txt ./requirements.txt
# Keep the comparatively expensive, architecture-specific Python dependency
# layer independent from OS presentation packages. A font or timezone change
# must not force pip to run again under ARM64 emulation.
# PyYAML (from uvicorn[standard]) has no Linux wheel for Python 3.15 yet: pip
# builds its pure-Python version, since the image has no C compiler.
RUN pip install --no-cache-dir -r requirements.txt

# LibreOffice Impress renders PowerPoint slides for the Word versions of the reports and the previews of the
# PowerPoint ones; Writer renders the previews of the Word ones.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium nodejs node-ws npm tzdata fonts-liberation libreoffice-impress-nogui \
       libreoffice-writer-nogui \
    && ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime \
    && echo ${TZ} > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# The generator of the presentations of the Help draws them again with live figures (src/modules/help/presentations.py): its
# packages are installed from their lock file, in a layer of their own.
COPY tools/presentations/package.json tools/presentations/package-lock.json ./tools/presentations/
RUN npm ci --prefix tools/presentations --omit=dev --no-audit --no-fund && npm cache clean --force

# The latest-noavx image replaces the official DuckDB wheel (x86-64-v3, AVX2) with the one compiled for x86-64-v2 by the
# Build DuckDB without AVX workflow. It comes after the heavy layers so both images share them.
ARG DUCKDB_WHEEL_URL=""
RUN if [ -n "${DUCKDB_WHEEL_URL}" ]; then pip install --no-cache-dir --no-deps --force-reinstall "${DUCKDB_WHEEL_URL}"; fi

# Keep dependency layers cacheable, but make every application layer belong to
# one exact Git commit. This also leaves a directly inspectable revision inside
# the running container instead of relying on mutable tags such as `latest`.
ARG SOURCE_REVISION=local
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"
RUN printf '%s\n' "${SOURCE_REVISION}" > /app/.source-revision

COPY src ./src
# The sources of the presentations of the Help, which the server generates once started (its packages stay those above).
COPY tools/presentations ./tools/presentations
COPY assets ./assets
COPY help ./help
COPY README.md ./README.md
COPY CHANGELOG.md ./CHANGELOG.md
COPY CONTRIBUTING.md ./CONTRIBUTING.md
COPY CODE_OF_CONDUCT.md ./CODE_OF_CONDUCT.md

RUN mkdir -p /app/config /app/data/input /app/data/output/reports

EXPOSE 7278
CMD ["python", "-m", "src.main"]
